# Server-only: direct upstream API (SSR and Nitro proxy target)
NUXT_API_BASE=http://localhost:8000/api/v1
# Browser-facing base (same-origin; proxied to NUXT_API_BASE in dev and via routeRules in production)
NUXT_PUBLIC_API_BASE=/api/v1
# Absolute API origin for /media URLs in the browser (JSON API stays on NUXT_PUBLIC_API_BASE)
NUXT_PUBLIC_MEDIA_BASE=http://localhost:8000
